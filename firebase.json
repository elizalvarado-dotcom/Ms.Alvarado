{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/financial-literacy",
        "destination": "/financial-literacy.html"
      },
      {
        "source": "/financial-literacy/**",
        "destination": "/financial-literacy.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
